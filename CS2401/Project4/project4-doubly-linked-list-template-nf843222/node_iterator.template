using namespace std;

template<class T>
node_iterator<T> node_iterator<T>::operator++(){
    if(cursor == nullptr){
        return *this;
    }
    cursor = cursor->next();
    return cursor;
}

template<class T>
node_iterator<T> node_iterator<T>::operator++(int){
    if(cursor == nullptr){
        return *this;
    }
    node_iterator<T> temp(cursor);
    cursor = cursor->next();
    return temp;
}

template<class T>
node_iterator<T> node_iterator<T>::operator--(){
    if(cursor == nullptr){
        return *this;
    }
    cursor = cursor->previous();
    return cursor;
}

template<class T>
node_iterator<T> node_iterator<T>::operator--(int){
    if(cursor == nullptr){
        return *this;
    }
    node_iterator<T> temp(cursor);
    cursor = cursor->previous();
    return temp;
}

template<class T>
bool node_iterator<T>::operator==(const node_iterator& other) const{
    if(this == &other){
        return true;
    }
    else{
        return false;
    }
}

template<class T>
bool node_iterator<T>::operator!=(const node_iterator& other) const{
    if(this != &other){
        return true;
    }
    else{
        return false;
    }
}

