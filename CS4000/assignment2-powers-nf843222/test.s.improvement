#!/bin/bash
#
# students must NOT change this file in any way!!!
PATH=/bin:/usr/bin
TEST=$0

# this is the input and output to use
INPUT="10000"
CORRECT="204500"

# this is the correct output
# this is the output they should create
echo "Answer = $CORRECT" > $TEST.correct 2>&1

# don't change anything else
COMMAND="echo $INPUT | ./my_parallel > $TEST.myoutput"
echo "running nthreads $NTHREADS: $COMMAND"
rm -f .times
for NTHREADS in 1 2 3 4; do
    for ITER in 1 2 3; do
        export OMP_NUM_THREADS=$NTHREADS
        (eval time $COMMAND) > .times 2>&1
        TIME=`awk '/real/ {print $2}' .times`
        if cmp -s $TEST.correct $TEST.myoutput; then
            RESULT="CORRECT"
        else
            RESULT="WRONG"
        fi    
        echo "iter=$ITER  nthreads=$NTHREADS $TIME $RESULT"
    done
done

if cmp -s $TEST.correct $TEST.myoutput; then
    echo "PASSES"; exit 0
else
    echo "FAILS"; 
    diff $TEST.correct $TEST.myoutput
    exit 99
fi
